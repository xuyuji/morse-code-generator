{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dotsdashes",
  "account_id": "0e406706300366fa2eb2edb388905b46",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "html_handling": "force-trailing-slash" },
  "routes": [
    { "pattern": "dotsdashes.com", "custom_domain": true },
    { "pattern": "www.dotsdashes.com", "custom_domain": true }
  ],
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "env": {
    "dev": {
      "name": "dotsdashes-dev",
      "workers_dev": false,
      "preview_urls": false,
      "assets": { "directory": "./dist", "not_found_handling": "404-page", "html_handling": "force-trailing-slash" },
      "routes": [{ "pattern": "dev.dotsdashes.com", "custom_domain": true }],
      "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
    }
  }
}
