---
import Site from '../layouts/Site.astro';import Converter from './Converter.astro';import Alphabet from './Alphabet.astro';import {content,labels,pageMeta,paths,url,type Locale,type Tool} from '../content/site';import {MORSE} from '../core/morse';
const {locale,tool}=Astro.props as {locale:Locale;tool:Tool};const t=labels[locale],meta=pageMeta[locale][tool],copy=content[locale][tool];
---
<Site locale={locale} title={meta.title} description={meta.description} path={paths[tool]} tool={tool}>
<div class="heading"><p class="eyebrow">{t.tag}</p><h1>{meta.h1}</h1><p class="intro">{meta.intro}</p></div>
{tool==='alphabet'?<Alphabet locale={locale}/>:<Converter locale={locale} generator={tool==='generator'}/>}
<div class="below-tool"><nav class="jump-links" aria-label={locale==='zh'?'页面目录':'On this page'}><a href="#how-to">{t.help}</a><a href="#questions">{locale==='zh'?'常见问题':'Common questions'}</a><a href="#related">{t.related}</a></nav>
<section class="overview" id="how-to"><div><p class="eyebrow">{locale==='zh'?'从这里开始':'A QUICK START'}</p><h2>{t.guide}</h2><p>{copy.lead}</p></div><ol class="steps">{copy.steps.map((step,i)=><li><span aria-hidden="true">0{i+1}</span><p>{step}</p></li>)}</ol></section>
{tool==='translator'&&<section class="mini-reference"><div class="section-heading"><h2>{locale==='zh'?'常见字符，一眼查到':'A few useful characters'}</h2><a href={url(locale,paths.alphabet)}>{locale==='zh'?'查看完整对照表 →':'Explore the alphabet →'}</a></div><div class="reference-strip">{['A','E','H','L','O','S','1','2'].map(c=><div><strong>{c}</strong><code>{MORSE[c]}</code></div>)}</div></section>}
<div class="reading-grid">{copy.sections.map(section=><section><h2>{section.heading}</h2>{section.paragraphs.map(p=><p>{p}</p>)}</section>)}</div>
<section id="questions" class="faq"><p class="eyebrow">{locale==='zh'?'你可能还想知道':'GOOD QUESTIONS'}</p><h2>{locale==='zh'?'关于这个工具，你可能想问':'A few things you might be wondering'}</h2>{copy.faq.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</section>
<aside class="source-note"><strong>{t.source}</strong><p>{locale==='zh'?'字符映射和标准间隔参考 ITU-R M.1677-1。本站明确列出支持范围，不包含所有扩展字母、程序信号或中文电报码。':'Character mappings and standard spacing follow ITU-R M.1677-1. Our supported subset excludes national letter extensions, procedural signals and Chinese telegraph codes.'} <a href="https://www.itu.int/rec/R-REC-M.1677-1-200910-I/en">ITU-R M.1677-1 ↗</a></p></aside>
<section id="related" class="related"><h2>{t.related}</h2><div>{(Object.keys(paths) as Tool[]).filter(key=>key!==tool).map(key=><a href={url(locale,paths[key])}><span class="eyebrow">{key==='alphabet'?'A · B · C':key==='generator'?'PLAY · SAVE':'TEXT ⇄ CODE'}</span><h3>{pageMeta[locale][key].h1}<span aria-hidden="true"> ↗</span></h3><p>{pageMeta[locale][key].intro}</p></a>)}</div></section>
<a class="back-top" href="#main">↑ {t.top}</a></div>
</Site>
