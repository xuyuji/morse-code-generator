{
  "name": "dotsdashes",
  "version": "0.0.0",
  "private": true,
  "description": "Bilingual, mobile-first Morse code tools",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "prototype": "node scripts/preview.mjs",
    "check:docs": "node scripts/check.mjs",
    "check": "astro check && npm run check:docs",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:dev": "node scripts/build.mjs dev",
    "deploy:ci": "node scripts/deploy-ci.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.150.0"
  }
}
